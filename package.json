{
  "name": "nuxt-safe-action",
  "version": "0.6.0",
  "description": "Type-safe Nuxt server actions with Standard Schema validation, forms and optimistic updates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rutbergphilip/nuxt-safe-action.git"
  },
  "homepage": "https://nuxt-safe-action.vercel.app",
  "bugs": {
    "url": "https://github.com/rutbergphilip/nuxt-safe-action/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "server-actions",
    "type-safe",
    "validation",
    "zod",
    "middleware",
    "vue",
    "nuxt3",
    "nuxt4",
    "vue3",
    "typescript",
    "form-validation",
    "rpc",
    "h3",
    "nitro",
    "server-functions",
    "composable",
    "standard-schema",
    "valibot",
    "arktype",
    "optimistic-updates"
  ],
  "author": "Philip Rutberg",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "pnpm verify && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "docs:dev": "nuxi dev docs",
    "docs:build": "nuxi build docs",
    "docs:generate": "nuxi generate docs",
    "verify": "pnpm dev:prepare && pnpm lint && pnpm test:types && pnpm test && pnpm prepack && pnpm test:package && pnpm docs:build",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "defu": "^6.1.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint-config": "^1.14.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.1",
    "@nuxt/test-utils": "^4.0.0",
    "@types/node": "latest",
    "arktype": "^2.2.8",
    "changelogen": "^0.6.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "h3": "^1.15.5",
    "nuxt": "^4.3.1",
    "ofetch": "^1.5.1",
    "typescript": "~5.9.3",
    "valibot": "^1.5.0",
    "vitest": "^4.0.18",
    "vue": "^3.5.28",
    "vue-tsc": "^3.2.4",
    "zod": "^3.24.0",
    "zod3": "npm:zod@3.20.6",
    "zod4": "npm:zod@^4.3.6"
  },
  "peerDependencies": {
    "zod": "^3.20.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@11.0.9"
}
